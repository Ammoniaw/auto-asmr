{
  "manifest_version": 3,
  "name": "auto-asmr",
  "version": "0.1.0",
  "description": "把标签页里的声音实时做成 KU100 双耳 ASMR 效果再播放。引擎和配置文件与桌面版相同。",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "auto-asmr：处理这个标签页的声音",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "开始 / 停止处理当前标签页的声音"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
